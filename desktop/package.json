{
  "name": "cutroom-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Cutroom desktop editing application (Electron + Vue).",
  "author": "Cutroom",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build:native:mac": "node scripts/build-native-mac.mjs",
    "build": "npm run build:native:mac && electron-vite build && npm run bundle:budget && node scripts/audit-preload.cjs && node scripts/audit-main-keychain.cjs",
    "bundle:budget": "node scripts/check-renderer-budgets.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "screenshots": "playwright test -c playwright.config.ts",
    "visual:baselines": "node scripts/visual-baselines.mjs",
    "visual:baselines:update": "node scripts/visual-baselines.mjs --update",
    "typecheck:test": "tsc --noEmit -p tsconfig.test-web.json && tsc --noEmit -p tsconfig.test-node.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "package:dir": "electron-builder --dir --publish never --config electron-builder.preview.cjs",
    "package:smoke": "node scripts/run-packaged-smoke.cjs",
    "package:verify": "npm run package:dir && npm run package:smoke",
    "package:probe": "node scripts/probe-packaged-hardening.cjs",
    "dist:mac": "cd .. && scripts/build_desktop_release.sh",
    "dist": "npm run dist:mac"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "1.8.0",
    "@emperor/core": "file:../packages/core",
    "@playwright/test": "^1.61.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "diff": "^9.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "gsap": "3.13.0",
    "highlight.js": "^11.11.2",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.1.1",
    "postcss": "^8.4.49",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "typescript": "5.9.3"
  }
}
